# Clé API Groq (gratuite sur https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAlex (optionnel mais recommandé — rejoint le "polite pool" = rate limit
# bien plus élevé et plus stable). Mets simplement ton email, pas de clé requise.
OPENALEX_MAILTO=

# Semantic Scholar (déconseillé — rate limit très strict sans clé, 429 fréquents)
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scifit
POSTGRES_USER=scifit
POSTGRES_PASSWORD=scifit_local_pw

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=scifit_chunks

# Modèle d'embedding local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
